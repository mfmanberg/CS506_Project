import duckdb
import pandas as pd
import xgboost as xgb
from sklearn.metrics import root_mean_squared_error, r2_score
import matplotlib.pyplot as plt
from xgboost.callback import EarlyStopping
from sklearn.metrics import mean_absolute_error



print("XGBoost version:", xgb.__version__)

# Load station data
con = duckdb.connect()
station = "GENESE"

df = con.execute(f"""
    SELECT "Time Stamp", Load, Name
    FROM parquet_scan('nyiso_dataset/**/*.parquet')
    WHERE Name = '{station}'
    ORDER BY "Time Stamp"
""").df()


# Preproc
df["Time Stamp"] = pd.to_datetime(df["Time Stamp"], errors="coerce")
df = df.dropna(subset=["Time Stamp"])
df = df.sort_values("Time Stamp")



# Extract year for splitting
df["year"] = df["Time Stamp"].dt.year


# Lag feature columns are just the same load column shifted by 1, 7, and 30 days, so the model can properly learn time series patterns.
for lag in [1, 7, 30]:
    df[f"lag_{lag}"] = df["Load"].shift(lag)

df = df.dropna()


train = df[(df["year"] >= 2001) & (df["year"] <= 2021)]
val   = df[df["year"] == 2022]
test  = df[df["year"].isin([2023, 2024, 2025])]

X_train = train[[f"lag_{l}" for l in [1, 7, 30]]]
y_train = train["Load"]

X_val = val[[f"lag_{l}" for l in [1, 7, 30]]]
y_val = val["Load"]

X_test = test[[f"lag_{l}" for l in [1, 7, 30]]]
y_test = test["Load"]

print(f"Train: {len(train)}, Val: {len(val)}, Test: {len(test)}")


# Train model

model = xgb.XGBRegressor(
    n_estimators=500,
    learning_rate=0.05,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    tree_method="hist",
    early_stopping_rounds=20,
    random_state=42
)

print("Model class:", type(model))

model.fit(
    X_train, y_train,
    eval_set=[(X_val, y_val)],
    verbose=True
)


# Eval
y_pred = model.predict(X_test)

rmse = root_mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
mae = mean_absolute_error(y_test, y_pred)
mape = (abs((y_test - y_pred) / y_test)).mean() * 100

print(f"MAPE: {mape:.2f}%")
print(f"MAE: {mae:.2f} MW")
print(f"Test RMSE: {rmse:.2f}")
print(f"Test R²: {r2:.3f}")

# Plot actual vs predicted

plt.figure(figsize=(14,6))
plt.plot(test["Time Stamp"], y_test.values, label="Actual", alpha=0.6)
plt.plot(test["Time Stamp"], y_pred, label="Predicted", alpha=0.8)
plt.title(f"{station} Load Prediction (2023–2025)")
plt.xlabel("Date")
plt.ylabel("Load (MW)")
plt.legend()
plt.show()


