import os, glob
import pandas as pd
import numpy as np
import xgboost as xgb
from sklearn.metrics import root_mean_squared_error, r2_score, mean_absolute_error
import matplotlib.pyplot as plt

# =========================
# CONFIG SECTION
# =========================
CONFIG = {
    "station": "LONGIL",
    "lags": [1, 7, 30],
    "train_start": 2001,
    "train_end": 2021,
    "val_year": 2022,
    "test_years": [2023, 2024, 2025],
    "model": {
        "n_estimators": 300,
        "learning_rate": 0.05,
        "max_depth": 6,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "tree_method": "hist",
        "early_stopping_rounds": 20,
        "random_state": 42
    },
    "source_dir": r"1_LIB\nyiso\nyiso_parquet"
}

# =========================
# PARQUET LOADING & AGGREGATION
# =========================
def find_parquets(src):
    pattern = os.path.join(src, '**', '*.parquet')
    return sorted(glob.glob(pattern, recursive=True))

def load_parquets(paths):
    dfs = []
    for p in paths:
        try:
            df = pd.read_parquet(p)
            df['_source_file'] = os.path.basename(p)
            dfs.append(df)
        except Exception as e:
            print(f"Warning: failed to read {p}: {e}")
    if not dfs:
        return pd.DataFrame()
    return pd.concat(dfs, ignore_index=True)

def ensure_datetime(df, col='Time Stamp'):
    if col in df.columns:
        df[col] = pd.to_datetime(df[col], errors='coerce')
    else:
        for alt in ['Timestamp','timestamp','time','datetime','time_stamp']:
            if alt in df.columns:
                df.rename(columns={alt: col}, inplace=True)
                df[col] = pd.to_datetime(df[col], errors='coerce')
                break
    return df

# Load and aggregate
paths = find_parquets(CONFIG["source_dir"])
print(f"Found {len(paths)} parquet files under {CONFIG['source_dir']}")
df_all = load_parquets(paths)
print(f"Loaded total rows: {len(df_all)}")

if df_all.empty:
    raise ValueError("No data loaded from parquet files! Check pyarrow/fastparquet.")
else:
    df_all = ensure_datetime(df_all)
    df_all.set_index('Time Stamp', inplace=True)
    five = df_all['Load'].resample('5min').sum().to_frame('Load')
    quarter = df_all['Load'].resample('15min').sum().to_frame('Load')
    hourly = df_all['Load'].resample('1h').sum().to_frame('Load')
    daily = df_all['Load'].resample('1d').sum().to_frame('Load')
    per_name_daily = df_all.groupby([pd.Grouper(freq='D'), 'Name'])['Load'].sum().unstack(fill_value=0)
    print("Aggregates created: five, quarter, hourly, daily, per_name_daily")

# =========================
# XGBOOST FUNCTION
# =========================
def run_xgboost_on_df(df, station=CONFIG["station"], lags=CONFIG["lags"],
                      train_start=CONFIG["train_start"], train_end=CONFIG["train_end"],
                      val_year=CONFIG["val_year"], test_years=CONFIG["test_years"],
                      model_params=CONFIG["model"]):

    df = df.copy()
    if 'Name' not in df.columns:
        df['Name'] = station
    if 'Time Stamp' not in df.columns:
        df = df.reset_index()
        df.rename(columns={df.columns[0]: 'Time Stamp'}, inplace=True)

    df['Time Stamp'] = pd.to_datetime(df['Time Stamp'], errors='coerce')
    df = df.dropna(subset=['Time Stamp'])
    df = df.sort_values('Time Stamp')
    df['year'] = df['Time Stamp'].dt.year
    df = df[df['Name'] == station]

    # Lags
    for lag in lags:
        df[f'lag_{lag}'] = df['Load'].shift(lag)
    df = df.dropna()

    # Split
    if df['year'].nunique() == 1:
        cutoff = int(len(df) * 0.8)
        train, test = df.iloc[:cutoff], df.iloc[cutoff:]
        val = test.copy()
    else:
        train = df[(df['year'] >= train_start) & (df['year'] <= train_end)]
        val = df[df['year'] == val_year]
        test = df[df['year'].isin(test_years)]

    X_train = train[[f'lag_{l}' for l in lags]]
    y_train = train['Load']
    X_val = val[[f'lag_{l}' for l in lags]]
    y_val = val['Load']
    X_test = test[[f'lag_{l}' for l in lags]]
    y_test = test['Load']

    print(f"Train: {len(train)}, Val: {len(val)}, Test: {len(test)}")

    # Train
    model = xgb.XGBRegressor(**model_params)
    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=True)

    # Predictions
    y_pred = model.predict(X_test)

    # Metrics with robust MAPE
    rmse = root_mean_squared_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)
    mae = mean_absolute_error(y_test, y_pred)
    # Ignore zeros to prevent exploding MAPE, especially for five
    mask = y_test != 0
    mape = (abs((y_test[mask] - y_pred[mask]) / y_test[mask])).mean() * 100

    print(f"MAPE: {mape:.2f}% | MAE: {mae:.2f} MW | RMSE: {rmse:.2f} | R²: {r2:.3f}")

    # Plot
    plt.figure(figsize=(14,6))
    plt.plot(test['Time Stamp'], y_test.values, label='Actual', alpha=0.6)
    plt.plot(test['Time Stamp'], y_pred, label='Predicted', alpha=0.8)
    plt.title(f'{station} Load Prediction')
    plt.xlabel('Date')
    plt.ylabel('Load (MW)')
    plt.legend()
    plt.show()

    return {"MAPE": mape, "MAE": mae, "RMSE": rmse, "R2": r2}

# =========================
# RUN XGBOOST ON ALL AGGREGATES & COLLECT RESULTS
# =========================
if __name__ == "__main__":
    results = {}
    for agg_name, agg_df in zip(['five', 'quarter', 'hourly', 'daily'], [five, quarter, hourly, daily]):
        print(f"\n==== Running XGBoost on {agg_name} aggregate ====")
        metrics = run_xgboost_on_df(agg_df, station=CONFIG["station"])
        results[agg_name] = metrics

    # Final results table
    results_df = pd.DataFrame(results).T
    results_df = results_df[['MAPE', 'MAE', 'RMSE', 'R2']]
    print("\n==== Summary of all aggregates ====")
    print(results_df)
