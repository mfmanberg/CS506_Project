# CS506 Project - WSL Makefile
# Linux-compatible makefile for automated notebook execution
# Run from project root: make -f Makefile/Makefile.wsl

# Configuration
SHELL := /bin/bash
# Get the directory of this Makefile, then go up one level to project root
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT := $(abspath $(MAKEFILE_DIR)/..)
PYTHON := $(PROJECT_ROOT)/.venv_wsl/bin/python
PIP := $(PROJECT_ROOT)/.venv_wsl/bin/pip
PAPERMILL := $(PROJECT_ROOT)/.venv_wsl/bin/papermill
VENV_DIR := $(PROJECT_ROOT)/.venv_wsl
REQUIREMENTS := $(PROJECT_ROOT)/Dependencies/requirements.txt

# Notebook paths (relative to PROJECT_ROOT)
NOTEBOOKS := \
	$(PROJECT_ROOT)/2_FIGURES/2_data_exploration/nyiso_data_exploration.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_linear_regression/linear_regression.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVM_Trunc.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMDaily.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMDailywoutMeso.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMHourly.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/ComparisonMetrics.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/XGBoost_PostMid.ipynb \
	$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/XGBoost_Testing.ipynb

.PHONY: all setup run clean help check-deps

# Default target
all: check-deps run

# Setup virtual environment and install dependencies
setup:
	@echo "Setting up WSL environment..."
	@cd $(PROJECT_ROOT) && python3 -m venv .venv_wsl
	@$(PIP) install --upgrade pip
	@$(PIP) install -r $(REQUIREMENTS)
	@echo "✓ Virtual environment ready at $(VENV_DIR)"

# Check if venv exists and install/update dependencies
$(VENV_DIR):
	@echo "Virtual environment not found. Running setup..."
	@$(MAKE) -f Build/Makefile.wsl setup

# Check and install dependencies if needed
check-deps: $(VENV_DIR)
	@echo "Checking dependencies..."
	@if [ ! -f "$(VENV_DIR)/.deps_installed" ] || [ "$(REQUIREMENTS)" -nt "$(VENV_DIR)/.deps_installed" ]; then \
		echo "Installing/updating dependencies..."; \
		$(PIP) install --upgrade pip; \
		$(PIP) install -r $(REQUIREMENTS); \
		touch $(VENV_DIR)/.deps_installed; \
		echo "✓ Dependencies installed"; \
	else \
		echo "✓ Dependencies up to date"; \
	fi

# Run all notebooks
run: check-deps
	@echo "============================================================"
	@echo "Executing all notebooks in WSL"
	@echo "============================================================"
	@echo ""
	@source $(VENV_DIR)/bin/activate && \
	export PYTHONPATH="$(PROJECT_ROOT):$(PROJECT_ROOT)/Build:$$PYTHONPATH" && \
	COMPLETED=0 && \
	FAILED=0 && \
	TOTAL=9 && \
	mkdir -p /tmp/papermill_output && \
	for i in 1 2 3 4 5 6 7 8 9; do \
		case $$i in \
			1) NB="$(PROJECT_ROOT)/2_FIGURES/2_data_exploration/nyiso_data_exploration.ipynb";; \
			2) NB="$(PROJECT_ROOT)/3_OUTPUT/3_linear_regression/linear_regression.ipynb";; \
			3) NB="$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVM_Trunc.ipynb";; \
			4) NB="$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMDaily.ipynb";; \
			5) NB="$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMDailywoutMeso.ipynb";; \
			6) NB="$(PROJECT_ROOT)/3_OUTPUT/3_svr/SVMHourly.ipynb";; \
			7) NB="$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/ComparisonMetrics.ipynb";; \
			8) NB="$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/XGBoost_PostMid.ipynb";; \
			9) NB="$(PROJECT_ROOT)/3_OUTPUT/3_xg_boost/XGBoost_Testing.ipynb";; \
		esac; \
		echo ""; \
		echo "[$$i/$$TOTAL] Executing: $$(basename $$NB)"; \
		echo "----------------------------------------"; \
		if [ ! -f "$$NB" ]; then \
			echo "[FAILED] File not found: $$NB"; \
			FAILED=$$((FAILED + 1)); \
			continue; \
		fi; \
		TEMP_NB="/tmp/papermill_output/$$(basename $$NB)"; \
		if $(PAPERMILL) "$$NB" "$$TEMP_NB" --kernel python3 --execution-timeout 3600 --cwd "$(PROJECT_ROOT)" 2>&1; then \
			cp "$$TEMP_NB" "$$NB"; \
			echo "[SUCCESS] $$(basename $$NB)"; \
			COMPLETED=$$((COMPLETED + 1)); \
		else \
			echo "[FAILED] $$(basename $$NB)"; \
			FAILED=$$((FAILED + 1)); \
		fi; \
	done; \
	echo ""; \
	echo "============================================================"; \
	echo "SUMMARY"; \
	echo "============================================================"; \
	echo "Completed: $$COMPLETED/$$TOTAL"; \
	echo "Failed: $$FAILED/$$TOTAL"; \
	echo "============================================================"

# Run a specific notebook
run-nyiso-explore: check-deps
	@source $(VENV_DIR)/bin/activate && \
	export PYTHONPATH="$(PROJECT_ROOT):$(PROJECT_ROOT)/Build:$$PYTHONPATH" && \
	$(PAPERMILL) $(PROJECT_ROOT)/2_FIGURES/2_data_exploration/nyiso_data_exploration.ipynb \
		$(PROJECT_ROOT)/2_FIGURES/2_data_exploration/nyiso_data_exploration.ipynb \
		--kernel python3 --execution-timeout 3600 --cwd "$(PROJECT_ROOT)"

