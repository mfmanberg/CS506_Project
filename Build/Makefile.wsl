		--kernel python3 --execution-timeout 3600 --cwd "$(PROJECT_ROOT)"

# Clean virtual environment
clean-venv:
	@echo "Removing WSL virtual environment..."
	@rm -rf $(VENV_DIR)
	@echo "Done"

# Clean notebook outputs
clean-outputs:
	@echo "Cleaning notebook outputs..."
	@find $(PROJECT_ROOT)/3_OUTPUT -name "*.ipynb" -exec jupyter nbconvert --clear-output --inplace {} \;
	@echo "Done"

# Clean everything
clean: clean-outputs
	@echo "Cleaned notebook outputs"

# Show help
help:
	@echo "CS506 Project - WSL Makefile"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Main Targets:"
	@echo "  all (default)    - Run all notebooks"
	@echo "  setup            - Setup WSL virtual environment"
	@echo "  run              - Execute all notebooks"
	@echo ""
	@echo "Individual Notebooks:"
	@echo "  run-nyiso-explore - NYISO data exploration"
	@echo "  run-linear       - Linear regression"
	@echo "  run-svm-trunc    - SVM truncated"
	@echo "  run-svm-daily    - SVM daily"
	@echo "  run-svm-nomeso   - SVM without mesonet"
	@echo "  run-svm-hourly   - SVM hourly"
	@echo "  run-comparison   - Comparison metrics"
	@echo "  run-xgboost-post - XGBoost post-midterm"
	@echo "  run-xgboost-test - XGBoost testing"
	@echo ""
	@echo "Maintenance:"
	@echo "  clean-venv       - Remove virtual environment"
	@echo "  clean-outputs    - Clear notebook outputs"
	@echo "  clean            - Clean outputs"
	@echo "  help             - Show this help"
