# Simplified Makefile for CS506 Project
# Runs notebooks sequentially with better error handling

SHELL := /bin/bash
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT := $(abspath $(MAKEFILE_DIR)/..)
PYTHON := $(PROJECT_ROOT)/.venv_wsl/bin/python
PAPERMILL := $(PROJECT_ROOT)/.venv_wsl/bin/papermill
VENV_DIR := $(PROJECT_ROOT)/.venv_wsl

# Notebook list
NOTEBOOKS := \
	2_FIGURES/2_data_exploration/nyiso_data_exploration.ipynb \
	3_OUTPUT/3_linear_regression/linear_regression.ipynb \
	3_OUTPUT/3_svr/SVM_Trunc.ipynb \
	3_OUTPUT/3_svr/SVMDaily.ipynb \
	3_OUTPUT/3_svr/SVMDailywoutMeso.ipynb \
	3_OUTPUT/3_svr/SVMHourly.ipynb \
	3_OUTPUT/3_xg_boost/ComparisonMetrics.ipynb \
	3_OUTPUT/3_xg_boost/XGBoost_PostMid.ipynb \
	3_OUTPUT/3_xg_boost/XGBoost_Testing.ipynb

.PHONY: all run clean setup check-env

all: setup run

setup: check-env
	@echo "============================================================"
	@echo "Checking Dependencies"
	@echo "============================================================"
	@if [ ! -d "$(VENV_DIR)" ]; then \
		echo "ERROR: Virtual environment not found at $(VENV_DIR)"; \
		echo "Creating virtual environment..."; \
		python3.12 -m venv $(VENV_DIR) || python3 -m venv $(VENV_DIR); \
	fi
	@echo "Activating virtual environment..."
	@cd $(PROJECT_ROOT) && \
	source $(VENV_DIR)/bin/activate && \
	echo "Checking for required packages..." && \
	if ! python -c "import pandas, numpy, sklearn, xgboost, papermill" 2>/dev/null; then \
		echo "Installing dependencies from requirements.txt..." && \
		pip install --upgrade pip && \
		pip install -r Dependencies/requirements.txt; \
	else \
		echo "✓ All required packages already installed"; \
	fi
	@echo "============================================================"
	@echo "Setup Complete"
	@echo "============================================================"

check-env:
	@echo "Environment Check:"
	@echo "  Project Root: $(PROJECT_ROOT)"
	@echo "  Virtual Env: $(VENV_DIR)"
	@echo "  Python: $(PYTHON)"
	@echo "  Papermill: $(PAPERMILL)"
	@echo ""

run: setup
	@echo "============================================================"
	@echo "Starting Notebook Execution"
	@echo "============================================================"
	@cd $(PROJECT_ROOT) && \
	source $(VENV_DIR)/bin/activate && \
	export PYTHONPATH="$(PROJECT_ROOT):$(PROJECT_ROOT)/Build" && \
	COMPLETED=0 && \
	FAILED=0 && \
	TOTAL=9 && \
	echo "" && \
	for nb in $(NOTEBOOKS); do \
		COUNT=$$((COMPLETED + FAILED + 1)); \
		echo "" && \
		echo "[$$COUNT/$$TOTAL] $$nb" && \
		echo "----------------------------------------" && \
		if [ ! -f "$$nb" ]; then \
			echo "SKIP: File not found" && \
			FAILED=$$((FAILED + 1)); \
			continue; \
		fi; \
		TEMP="/tmp/nb_$$$$.ipynb" && \
		if $(PAPERMILL) "$$nb" "$$TEMP" \
			--kernel python3 \
			--execution-timeout 3600 \
			--cwd "$(PROJECT_ROOT)" 2>&1; then \
			cp "$$TEMP" "$$nb" && \
			rm -f "$$TEMP" && \
			echo "SUCCESS" && \
			COMPLETED=$$((COMPLETED + 1)); \
		else \
			rm -f "$$TEMP" && \
			echo "FAILED" && \
			FAILED=$$((FAILED + 1)); \
		fi; \
		sleep 2; \
	done && \
	echo "" && \
	echo "============================================================" && \
	echo "Build Complete" && \
	echo "============================================================" && \
	echo "Success: $$COMPLETED/$$TOTAL" && \
	echo "Failed:  $$FAILED/$$TOTAL" && \
	echo "============================================================"

clean:
	@rm -f /tmp/nb_*.ipynb
	@echo "Cleaned temporary files"
